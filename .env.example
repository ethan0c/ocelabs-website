# Copy to .env for local work. Set the same keys in Vercel for production.

# Gate for the internal /pricing pages. Changing the secret signs everyone out.
PRICING_PIN=
PRICING_SECRET=

# Restricted Stripe key with Customers: write and Invoices: write. A test key
# (sk_test_ / rk_test_) drafts into test mode. Without it, "Draft in Stripe"
# reports that the key is missing; nothing else is affected.
STRIPE_SECRET_KEY=

# Sole proprietor's legal name, printed on the proposal as
# "<name>, doing business as OCE Labs".
OCE_LEGAL_NAME=
