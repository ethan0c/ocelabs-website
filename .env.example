# Copy to .env for local work. Set the same keys in Vercel for production.
# Settings → Studio shows which of these are live.

# ── Site ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Links in emails and OAuth redirects use it.
SITE_URL=https://www.ocelabs.xyz
# Sole proprietor's legal name: "<name>, doing business as OCE Labs" on the agreement.
OCE_LEGAL_NAME=
# First name that signs the emails.
STUDIO_SIGNER=

# ── Database (Neon via the Vercel Marketplace; injected automatically there) ─
DATABASE_URL=

# ── Studio sign-in (Google OAuth) ───────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URIs:
#   <SITE_URL>/api/auth/callback
#   <SITE_URL>/api/gmail/callback
# Enable the Gmail API on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random, long. `openssl rand -hex 32`. Rotating it signs everyone out.
AUTH_SECRET=
# Who may sign in, comma-separated.
STUDIO_ALLOWED_EMAILS=hello@ocelabs.xyz,partner@example.com
# The mailbox the studio sends from (pre-fills Google's account picker).
STUDIO_FROM_EMAIL=hello@ocelabs.xyz

# ── Stripe ───────────────────────────────────────────────────────────────────
# Restricted key: Customers write, Invoices write. rk_test_ until the first real client.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint <SITE_URL>/api/webhooks/stripe, event invoice.paid.
STRIPE_WEBHOOK_SECRET=

# ── Cal.com ──────────────────────────────────────────────────────────────────
# The intro-call booking link that goes in Email A.
CAL_LINK=https://cal.com/ocelabs/intro
# Settings → Developer → Webhooks → <SITE_URL>/api/webhooks/cal, BOOKING_CREATED.
CALCOM_WEBHOOK_SECRET=

# ── Automation ──────────────────────────────────────────────────────────────
# Vercel sends this with the daily cron. `openssl rand -hex 24`.
CRON_SECRET=
# Set to "false" to stop the contact form replying with Email A by itself.
AUTO_EMAIL_A=true
# Optional shared folder link for client files, mentioned in Email D.
CLIENT_FOLDER_LINK=
